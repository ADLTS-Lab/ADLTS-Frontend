# Local developer default: use the built-in Next.js mock API
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_ALLOW_LOCAL_FALLBACK=false

# To proxy to a backend while avoiding browser CORS during local development:
# NEXT_PUBLIC_API_BASE_URL=/backend/api/v1
# BACKEND_ORIGIN=http://localhost:8080
#
# Or point directly to a backend/API mock server:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
#
# Optional: comma-separated extra hosts allowed to access Next dev HMR.
# The current machine's LAN IPv4 addresses are allowed automatically.
# NEXT_ALLOWED_DEV_ORIGINS=10.245.116.114
