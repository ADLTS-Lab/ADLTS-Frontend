# Real backend integration (recommended default)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_ALLOW_LOCAL_FALLBACK=false

# Local mock mode (explicitly opt in)
# Set NEXT_PUBLIC_API_BASE_URL blank or /api/v1 and enable fallback:
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NEXT_PUBLIC_ALLOW_LOCAL_FALLBACK=true
